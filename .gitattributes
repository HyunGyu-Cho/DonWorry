# 줄바꿈 정규화: 저장소에는 LF로 저장
* text=auto eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat text eol=crlf
*.cmd text eol=crlf

# gradlew 는 반드시 LF (CRLF면 Linux/macOS에서 실행 실패)
# 실행 권한은 git 모드로 관리한다. Windows 에서 새로 추가하면 100644 가 되므로
# `git update-index --chmod=+x backend/gradlew` 로 고쳐야 CI 에서 실행된다.
gradlew text eol=lf

# 바이너리
*.jar binary
*.png binary
*.jpg binary
*.ico binary
