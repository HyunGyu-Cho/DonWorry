# ai-server 내 PC 설정 — 복사해서 ai-server/.env 로 쓴다 (git 제외). 키 값은 이 예시 파일에 적지 않는다
# 아래 시연 값(Spring 주소 · 단계마다 1초)은 그대로 써도 된다 (#84)
# 보고서를 쓰는 AI: mock = 가짜 AI(정해진 순서), ollama = 내 PC의 Qwen, openai = OpenAI
AI_SERVER_LLM_PROVIDER=mock
# ollama면 미리 받아 둔 모델 이름 (ollama pull qwen2.5:7b). openai면 예: gpt-4o-mini
AI_SERVER_LLM_MODEL=qwen2.5:7b
# openai만 필요 — 직접 입력, 저장소에 올리지 않는다
AI_SERVER_LLM_API_KEY=
# AI 한 번 답을 기다리는 시간(초). CPU로 돌리는 7b는 1분 넘게 걸릴 수 있다
AI_SERVER_LLM_TIMEOUT_SECONDS=180
# Spring과 같은 서비스 간 키 (X-Service-Key). backend/.env의 DONWORRY_AI_SERVER_SERVICE_KEY와 같은 값을 직접 넣는다
# 비어 있으면 조사 API가 모두 503 → 사건 화면에 "AI 조사에 실패했어요"
AI_SERVER_SERVICE_KEY=
# 시연용: 가짜 AI가 처음 N번 형식이 틀린 답을 냄 (시나리오 ② "1차 실패 → 다시 시도")
AI_SERVER_MOCK_INVALID_ANSWERS=0
# 시연용: 가짜 AI가 그다음 N번은 증거에 없는 숫자를 지어냄 ("근거 검사 실패 → 다시 시도")
AI_SERVER_MOCK_UNGROUNDED_ANSWERS=0
# 시연용: 가짜 AI가 한 번 답하는 데 걸리는 시간(초) — 창구 요청도 한 번으로 센다
AI_SERVER_MOCK_DELAY_SECONDS=1
# 조사 결과를 보내고 증거 조회 창구를 부를 Spring 주소 (비우면 창구 없이 조사 · 결과도 안 보냄). Spring 기본 포트 8081
AI_SERVER_SPRING_BASE_URL=http://localhost:8081
# 한 시도에서 AI가 부를 수 있는 증거 조회 창구 수
AI_SERVER_MAX_TOOL_CALLS=8
