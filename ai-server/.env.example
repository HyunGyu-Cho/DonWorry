# 복사해서 .env 로 쓴다 (git 제외). 값은 여기에 적지 않는다
AI_SERVER_LLM_PROVIDER=mock
AI_SERVER_LLM_API_KEY=
# Spring과 같은 서비스 간 키 (X-Service-Key). 비어 있으면 조사 API가 모두 503
AI_SERVER_SERVICE_KEY=
# 시연용: 가짜 AI가 처음 N번 형식이 틀린 답을 냄 (시나리오 ② "1차 실패 → 다시 시도")
AI_SERVER_MOCK_INVALID_ANSWERS=0
# 시연용: 가짜 AI가 한 번 답하는 데 걸리는 시간(초)
AI_SERVER_MOCK_DELAY_SECONDS=0
# 조사 결과를 보낼 Spring 주소 (비우면 보내지 않음). Spring 기본 포트 8081
AI_SERVER_SPRING_BASE_URL=http://localhost:8081
