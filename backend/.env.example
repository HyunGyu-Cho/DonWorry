# 백엔드 내 PC 설정 — 이 파일을 복사해 backend/.env 로 쓴다 (git 제외, #84)
# 주의: 줄을 남기고 값을 비우면 "빈 값"이 된다 — 안 쓸 줄은 지우거나 앞에 #을 붙인다

# ── DB (기본: localhost:3307 / donworry / donworry) ──
# 개인용 DB(donworry_personal)나 다른 비밀번호를 쓸 때만 바꾼다 (아래는 기본값과 같다)
DONWORRY_DB_HOST=localhost
DONWORRY_DB_PORT=3307
DONWORRY_DB_NAME=donworry
DONWORRY_DB_USER=donworry
DONWORRY_DB_PASSWORD=donworry

# ── AI 조사 ──
# ai-server = ai-server에 조사를 맡김 (시연), fake = Spring 안의 템플릿으로 바로 완료
DONWORRY_REPORT_WRITER=ai-server
# ai-server/.env의 AI_SERVER_SERVICE_KEY와 같은 값을 직접 넣는다 (아무 문자열, 두 곳이 같으면 됨)
DONWORRY_AI_SERVER_SERVICE_KEY=
DONWORRY_AI_SERVER_URL=http://localhost:8000
# 조사 결과를 기다리는 시간. 진짜 AI(Ollama Qwen)는 몇 분 걸려서 5분 (가짜 AI만 쓰면 PT2M로 충분)
DONWORRY_REPORT_RESULT_TIMEOUT=PT5M

# ── 시연 ──
# 모의 카드사가 승인 취소 · 매입을 처리하는 시간. 그동안 사건은 "조치 진행 중" (ISO 기간, 예: PT5S = 5초)
DONWORRY_CARD_COMPANY_DELAY=PT5S
